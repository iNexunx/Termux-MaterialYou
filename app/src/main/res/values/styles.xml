<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="TermuxAlertDialogStyle" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <!-- Seen in buttons on alert dialog: -->
        <item name="android:colorAccent">#212121</item>
    </style>

    <style name="TermuxActivity.Drawer.ButtonBarStyle.Light" parent="@style/Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="TermuxActivity.Drawer.ButtonBarStyle.Dark" parent="@style/Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Material 3 pill-shaped button used by dialogs and the drawer actions. -->
    <style name="Widget.Termux.M3.PillButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">100dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="rippleColor">?attr/colorOnPrimary</item>
    </style>

    <style name="Widget.Termux.M3.PillButton.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">100dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="Widget.Termux.M3.DialogButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">100dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <style name="Widget.Termux.M3.DialogButton.Text" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">100dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="ThemeOverlay.Termux.M3.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Termux.M3.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Termux.M3.DialogButton.Text</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Termux.M3.DialogButton.Text</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Termux.M3.Dialog</item>
    </style>

    <style name="ShapeAppearance.Termux.M3.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="Widget.Termux.M3.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="thumbTint">@color/m3_switch_thumb</item>
        <item name="trackTint">@color/m3_switch_track</item>
    </style>

    <style name="Widget.Termux.M3" parent="@android:style/Widget" />

    <style name="Widget.Termux.M3.SelectionPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/m3_menu_pill</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="TextAppearance.Termux.M3.ActionMode" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">?attr/m3OnPrimaryContainer</item>
    </style>

    <style name="Widget.Termux.M3.ActionMode" parent="Widget.AppCompat.ActionMode">
        <item name="background">?attr/m3PrimaryContainer</item>
        <item name="titleTextStyle">@style/TextAppearance.Termux.M3.ActionMode</item>
        <item name="subtitleTextStyle">@style/TextAppearance.Termux.M3.ActionMode</item>
    </style>

    <style name="Widget.Termux.M3.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">28dp</item>
        <item name="boxCornerRadiusTopEnd">28dp</item>
        <item name="boxCornerRadiusBottomStart">28dp</item>
        <item name="boxCornerRadiusBottomEnd">28dp</item>
        <item name="boxStrokeColor">?attr/colorPrimary</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
    </style>

    <style name="Widget.Termux.M3.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="titleTextColor">?attr/colorOnPrimary</item>
    </style>

    <style name="PreferenceThemeOverlay.Termux.M3" parent="PreferenceThemeOverlay.v14.Material">
        <item name="preferenceCategoryStyle">@style/Preference.Category.Termux.M3</item>
        <item name="switchPreferenceCompatStyle">@style/Preference.SwitchPreferenceCompat.Termux.M3</item>
        <item name="preferenceStyle">@style/Preference.Termux.M3</item>
        <item name="dialogPreferenceStyle">@style/Preference.Termux.M3</item>
        <item name="preferenceScreenStyle">@style/Preference.Termux.M3</item>
    </style>

    <style name="Preference.Termux.M3" parent="Preference.Material">
        <item name="android:layout">@layout/m3_preference</item>
        <item name="iconSpaceReserved">false</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>

    <style name="Preference.Category.Termux.M3" parent="Preference.Category.Material">
        <item name="android:layout">@layout/m3_preference_category</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="Preference.SwitchPreferenceCompat.Termux.M3" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="android:layout">@layout/m3_preference</item>
        <item name="android:widgetLayout">@layout/m3_preference_switch</item>
        <item name="iconSpaceReserved">false</item>
    </style>

</resources>
